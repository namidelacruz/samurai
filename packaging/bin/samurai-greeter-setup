#!/bin/sh
# Sets up the Samurai login screen (greetd + Quickshell inside a bare Hyprland).
# Run as root by the installer (./install.sh --greeter) or by `samurai greeter apply` through pkexec.
#   samurai-greeter-setup black|white [USER]     set it up / refresh it
#   samurai-greeter-setup --remove               put the previous greetd config back
# It writes only: /etc/greetd/config.toml (the old one is kept as config.toml.before-samurai),
# /etc/samurai/greeter.json, /etc/samurai/greeter-hyprland.lua, /usr/share/samurai/greeter-*.svg.
# It never touches the bootloader, the initramfs or firmware settings.
set -eu
[ "$(id -u)" = 0 ] || { echo "samurai-greeter-setup: run as root" >&2; exit 1; }
GREETD=/etc/greetd/config.toml
if [ "${1:-}" = "--remove" ]; then
    if [ -f "$GREETD.before-samurai" ]; then mv -f "$GREETD.before-samurai" "$GREETD"
    elif [ -f "$GREETD" ] && grep -q samurai "$GREETD"; then
        # there was no config before ours: leave greetd its own stock text login, never a dead entry
        GU=greeter; id "$GU" >/dev/null 2>&1 || GU=_greetd
        printf '[terminal]\nvt = 1\n\n[default_session]\ncommand = "agreety --cmd /bin/sh"\nuser = "%s"\n' "$GU" > "$GREETD"
    fi
    rm -f /etc/samurai/greeter.json /etc/samurai/greeter-hyprland.lua
    echo "login screen: previous greetd config restored"; exit 0
fi
BASE=${1:-black}; case "$BASE" in black|white) ;; *) echo "base must be black or white" >&2; exit 2;; esac
OWNER=${2:-${PKEXEC_UID:+$(id -nu "$PKEXEC_UID")}}; OWNER=${OWNER:-${SUDO_USER:-}}
command -v greetd >/dev/null 2>&1 || { echo "greetd is not installed: the login screen was left alone" >&2; exit 3; }
QS=$(command -v qs || command -v quickshell || true)
[ -n "$QS" ] || { echo "quickshell is not installed: the login screen was left alone" >&2; exit 3; }
HYPR=$(command -v start-hyprland || command -v Hyprland || true)
[ -n "$HYPR" ] || { echo "Hyprland is not installed: the login screen was left alone" >&2; exit 3; }
SEP=""; case "$HYPR" in *start-hyprland) SEP=" --";; esac
GUSER=greeter; id "$GUSER" >/dev/null 2>&1 || GUSER=_greetd; id "$GUSER" >/dev/null 2>&1 || { echo "no greeter user (greeter / _greetd)" >&2; exit 3; }

mkdir -p /etc/samurai /usr/share/samurai
# the login screen shows the public decoy drawing, never the owner's one-time seal: it is on
# screen before anyone has proved who they are
for g in black white; do
    src=""
    [ -n "$OWNER" ] && src=$(eval echo "~$OWNER")/.config/samurai/seal/decoy-$g.svg
    [ -n "$src" ] && [ -f "$src" ] && install -m 0644 "$src" /usr/share/samurai/greeter-$g.svg
done
WALL=""; [ -f /usr/share/samurai/greeter-$BASE.svg ] && WALL=/usr/share/samurai/greeter-$BASE.svg
USERS=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { printf "%s\"%s\"", (n++ ? "," : ""), $1 }' /etc/passwd)
cat > /etc/samurai/greeter.json <<JSON
{ "base": "$BASE", "users": [$USERS], "show_users": true, "wall": "$WALL",
  "sessions": [{ "name": "Samurai", "exec": "$HYPR" }] }
JSON
cat > /etc/samurai/greeter-hyprland.lua <<LUA
-- samurai greeter: a bare Hyprland that shows one thing
hl.config({ misc = { disable_hyprland_logo = true, disable_splash_rendering = true, force_default_wallpaper = 0 },
            animations = { enabled = false }, general = { border_size = 0, gaps_in = 0, gaps_out = 0 } })
hl.on("hyprland.start", function() hl.exec_cmd("$QS -p /opt/samurai/shell/greeter; hyprctl dispatch 'hl.dsp.exit()'") end)
LUA
chmod 0644 /etc/samurai/greeter.json /etc/samurai/greeter-hyprland.lua
[ -f "$GREETD" ] && ! grep -q samurai "$GREETD" && [ ! -f "$GREETD.before-samurai" ] && cp -p "$GREETD" "$GREETD.before-samurai"
mkdir -p /etc/greetd
cat > "$GREETD" <<TOML
# written by samurai-greeter-setup (the previous file is config.toml.before-samurai)
[terminal]
vt = 1

[default_session]
command = "$HYPR$SEP --config /etc/samurai/greeter-hyprland.lua"
user = "$GUSER"
TOML
echo "login screen: set ($BASE). It shows at the next boot; nothing running was restarted."
