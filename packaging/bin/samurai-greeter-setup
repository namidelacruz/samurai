#!/bin/sh
# Sets up the Samurai login screen: greetd runs it in its own X server (X.Org or XLibre).
# Run as root by the installer or by `samurai greeter apply` (through pkexec).
#   samurai-greeter-setup night|paper [USER]     set it up / refresh it
#   samurai-greeter-setup --remove               put back what was there before
# Writes only: /etc/greetd/config.toml (the old one is kept as config.toml.before-samurai),
# /etc/samurai/greeter.json, /usr/share/samurai/greeter-*.svg, and which login manager starts at
# boot (the previous one is remembered in /etc/samurai/previous-display-manager). Nothing running is
# stopped or restarted: the change shows at the next boot.
# It never touches the bootloader, the initramfs or firmware settings.
set -eu
[ "$(id -u)" = 0 ] || { echo "samurai-greeter-setup: run as root" >&2; exit 1; }
GREETD=/etc/greetd/config.toml
DM=/etc/systemd/system/display-manager.service
POLKIT_RULE=/etc/polkit-1/rules.d/50-samurai-greeter-wifi.rules
greeter_user() { for u in greeter greetd _greetd; do id "$u" >/dev/null 2>&1 && { echo "$u"; return; }; done; return 1; }

if [ "${1:-}" = "--remove" ]; then
    if [ -f "$GREETD.before-samurai" ]; then mv -f "$GREETD.before-samurai" "$GREETD"
    elif [ -f "$GREETD" ] && grep -q samurai "$GREETD"; then
        # there was no config before ours: leave greetd its own stock text login, never a dead entry
        printf '[terminal]\nvt = 1\n\n[default_session]\ncommand = "agreety --cmd /bin/sh"\nuser = "%s"\n' "$(greeter_user || echo greeter)" > "$GREETD"
    fi
    if [ -f /etc/samurai/previous-display-manager ] && command -v systemctl >/dev/null 2>&1; then
        prev=$(cat /etc/samurai/previous-display-manager)
        if [ "$prev" = none ]; then systemctl disable greetd.service >/dev/null 2>&1 || true
        elif [ "$prev" != greetd.service ]; then systemctl enable --force "$prev" >/dev/null 2>&1 || true; fi
    fi
    rm -f /etc/samurai/greeter.json /etc/samurai/previous-display-manager /usr/share/samurai/greeter-night.svg /usr/share/samurai/greeter-paper.svg
    grep -qs "written by Samurai" "$POLKIT_RULE" && rm -f "$POLKIT_RULE"
    echo "login screen: what was there before is back (from the next boot)"; exit 0
fi

GROUND=${1:-night}; case "$GROUND" in night|paper) ;; *) echo "ground must be night or paper" >&2; exit 2;; esac
OWNER=${2:-}; [ -n "$OWNER" ] || { [ -z "${PKEXEC_UID:-}" ] || OWNER=$(id -nu "$PKEXEC_UID"); }; OWNER=${OWNER:-${SUDO_USER:-}}
# exit 3 = a part is missing: nothing is changed
missing() { echo "$1 is not installed: the login screen was left alone" >&2; exit 3; }
command -v greetd >/dev/null 2>&1 || missing greetd
command -v xinit >/dev/null 2>&1 || missing "xinit (xorg-xinit)"
command -v xauth >/dev/null 2>&1 || missing "xauth (xorg-xauth)"
{ command -v X || command -v Xorg; } >/dev/null 2>&1 || missing "an X server (X.Org or XLibre)"
python3 -c 'import PySide6.QtQuick' >/dev/null 2>&1 || missing "PySide6 (pyside6)"
GUSER=$(greeter_user) || { echo "no greeter user (greeter / greetd / _greetd): the login screen was left alone" >&2; exit 3; }
[ -x /opt/samurai/bin/samurai-greeter-run ] && [ -f /opt/samurai/greeter/greeter.py ] || { echo "Samurai is not installed in /opt/samurai" >&2; exit 3; }

# self-check: the login screen must load (normal and safe mode), as the user greetd runs it as,
# before greetd is made the login manager. If it does not, nothing is changed.
selfcheck() {
    for safe in 0 1; do
        out=$(cd / && timeout 60 runuser -u "$GUSER" -- env -i PATH=/usr/bin:/bin HOME=/ XDG_RUNTIME_DIR=/tmp \
              SAMURAI_GREETER_FAKE=1 SAMURAI_GREETER_CHECK=1 SAMURAI_GREETER_SAFE=$safe QT_QPA_PLATFORM=offscreen \
              QT_QUICK_BACKEND=software python3 /opt/samurai/greeter/greeter.py 2>&1)
        echo "$out" | grep -q "check ok" || { echo "the login screen failed its self-check (safe mode $safe):" >&2; echo "$out" | tail -n 8 >&2; return 1; }
    done
}
command -v runuser >/dev/null 2>&1 || missing "runuser (util-linux)"
selfcheck || { echo "the login screen was left alone" >&2; exit 3; }

mkdir -p /etc/samurai /usr/share/samurai /etc/greetd
# the login screen shows the public decoy drawing, never the owner's one-time seal: it is on
# screen before anyone has proved who they are
SCALE=1
if [ -n "$OWNER" ] && home=$(getent passwd "$OWNER" | cut -d: -f6) && [ -n "$home" ]; then
    for g in night paper; do
        src=$home/.config/samurai/seal/decoy-$g.svg
        [ -f "$src" ] && install -m 0644 "$src" /usr/share/samurai/greeter-$g.svg
    done
    # the owner's display scale, so the login is the same size as the desktop
    s=$(sed -n 's/^ *"look.scale" *: *\([0-9.]*\).*/\1/p' "$home/.config/samurai/settings.json" 2>/dev/null | head -n1)
    case "$s" in [0-9]*) SCALE=$s;; esac
fi
WALL=""; [ -f /usr/share/samurai/greeter-$GROUND.svg ] && WALL=/usr/share/samurai/greeter-$GROUND.svg
USERS=$(awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { printf "%s\"%s\"", (n++ ? "," : ""), $1 }' /etc/passwd)
NEW=/etc/samurai/greeter.json.new
cat > "$NEW" <<JSON
{ "ground": "$GROUND", "users": [$USERS], "wall": "$WALL", "scale": $SCALE }
JSON
python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$NEW" || { rm -f "$NEW"; echo "could not write the login screen's settings" >&2; exit 4; }
chmod 0644 "$NEW"; mv -f "$NEW" /etc/samurai/greeter.json

# Wi-Fi on the login screen: NetworkManager lets the login screen's user (and only that user)
# join networks for the whole machine. A file of your own with this name is kept.
if [ -d /etc/polkit-1/rules.d ] && { [ ! -e "$POLKIT_RULE" ] || grep -qs "written by Samurai" "$POLKIT_RULE"; }; then
    cat > "$POLKIT_RULE.new" <<JS
// samurai: written by Samurai (samurai-greeter-setup); removed by samurai-greeter-setup --remove.
// Lets the login screen's user "$GUSER" scan for Wi-Fi and join a network before anyone logs in.
// Nothing else is allowed: no other user, no other NetworkManager action.
polkit.addRule(function(action, subject) {
    if (subject.user == "$GUSER" &&
        (action.id == "org.freedesktop.NetworkManager.network-control" ||
         action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
         action.id == "org.freedesktop.NetworkManager.wifi.scan" ||
         action.id == "org.freedesktop.NetworkManager.enable-disable-wifi")) {
        return polkit.Result.YES;
    }
});
JS
    chmod 0644 "$POLKIT_RULE.new" && mv -f "$POLKIT_RULE.new" "$POLKIT_RULE"
fi

if [ -f "$GREETD" ] && ! grep -q samurai "$GREETD" && [ ! -f "$GREETD.before-samurai" ]; then cp -p "$GREETD" "$GREETD.before-samurai"; fi
cat > "$GREETD.new" <<TOML
# written by samurai-greeter-setup (the previous file, if any, is config.toml.before-samurai)
[terminal]
vt = 1

[default_session]
command = "/opt/samurai/bin/samurai-greeter-run"
user = "$GUSER"
TOML
mv -f "$GREETD.new" "$GREETD"

# make greetd the login manager that starts at boot, remembering the one it replaces
if command -v systemctl >/dev/null 2>&1; then
    if [ ! -f /etc/samurai/previous-display-manager ]; then
        prev=none; [ -L "$DM" ] && prev=$(basename "$(readlink "$DM")")
        echo "$prev" > /etc/samurai/previous-display-manager
    fi
    systemctl enable --force greetd.service >/dev/null 2>&1 || { echo "greetd.service could not be enabled; enable it yourself: systemctl enable --force greetd" >&2; exit 5; }
    systemctl set-default graphical.target >/dev/null 2>&1 || true
fi
echo "login screen: set ($GROUND). It shows at the next boot; nothing running was restarted."
