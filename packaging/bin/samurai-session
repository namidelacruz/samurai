#!/bin/sh
# Starts the Samurai desktop (or, with --run, another X11 session picked on the login screen).
#   samurai-session              from a console or greetd: start X here, then the desktop in it
#   samurai-session --run CMD    the same for another session's command (from /usr/share/xsessions)
# Inside a running X server (a display manager that starts X itself) it skips the first step.
BIN=${SAMURAI_PREFIX:-/opt/samurai}/bin
LOGDIR=${XDG_STATE_HOME:-$HOME/.local/state}/samurai
mkdir -p "$LOGDIR"
LOG=$LOGDIR/session.log
if [ -z "${DISPLAY:-}" ] && [ "${1:-}" != --inner ]; then
    # keep the last session's log, start a new one
    [ -f "$LOG" ] && mv -f "$LOG" "$LOG.old"
    start=$(date +%s)
    "$BIN/samurai-x" "$BIN/samurai-session" --inner "$@" >> "$LOG" 2>&1
    rc=$?
    # from a console (not greetd) say what happened, then go back to the shell: never loop
    if [ "$rc" != 0 ] && [ $(( $(date +%s) - start )) -lt 15 ] && [ -t 1 ]; then
        echo "Samurai could not start (code $rc). The last lines of $LOG:"
        tail -n 12 "$LOG" | sed 's/^/  /'
        echo "Help: 'If the login screen does not start' in Samurai's README, or run: samurai doctor"
    fi
    exit "$rc"
fi
[ "${1:-}" = --inner ] && shift
export XDG_SESSION_TYPE=x11
# the session bus the login started (systemd), so apps and portals can talk
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -S "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
fi
share_env() {
    command -v dbus-update-activation-environment >/dev/null 2>&1 &&
        dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP QT_QPA_PLATFORMTHEME 2>/dev/null
}
# keyboard and mouse settings from X's own config and ~/.Xresources still apply
[ -f "$HOME/.Xresources" ] && command -v xrdb >/dev/null 2>&1 && xrdb -merge "$HOME/.Xresources"
if [ "${1:-}" = --run ]; then
    shift
    unset XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP
    share_env
    echo "$(date): starting $*"
    exec sh -c "$*"
fi
export XDG_CURRENT_DESKTOP=Samurai XDG_SESSION_DESKTOP=samurai
export QT_QPA_PLATFORMTHEME=qt6ct MOZ_USE_XINPUT2=1 GTK_USE_PORTAL=0
export PATH="$BIN:$PATH"
share_env
echo "$(date): Samurai on $DISPLAY ($("$BIN/samurai" xserver 2>/dev/null | head -n1))"
"$BIN/samurai" session-start 2>&1 || echo "session-start reported a problem (the desktop starts anyway)"
# the size of everything (cursor, Qt rounding), written by samurai apply
ENVF=${SAMURAI_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/samurai}/session.env
[ -f "$ENVF" ] && . "$ENVF" && share_env && command -v dbus-update-activation-environment >/dev/null 2>&1 &&
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE QT_ENABLE_HIGHDPI_SCALING QT_SCALE_FACTOR_ROUNDING_POLICY 2>/dev/null
# the window manager: started again if it crashes, so a crash never logs you out. After three
# crashes within a minute it starts in safe mode (no animations, no transparency, no effects);
# if that crashes too, a terminal opens with the log instead of a black screen.
crashes=""
safe=0
while :; do
    start=$(date +%s)
    SAMURAI_WM_SAFE=$safe "$BIN/samurai-wm"; rc=$?
    ran=$(( $(date +%s) - start ))
    echo "$(date): samurai-wm left (code $rc after ${ran}s$( [ "$safe" = 1 ] && echo ', in safe mode'))"
    # 0: you logged out (or the X server went away): the session ends
    [ "$rc" = 0 ] && exit 0
    now=$(date +%s)
    recent=""
    for t in $crashes $now; do [ $((now - t)) -lt 60 ] && recent="$recent $t"; done
    crashes=$recent
    n=$(echo $crashes | wc -w)
    if [ "$n" -ge 3 ] && [ "$safe" = 1 ]; then
        echo "samurai-wm keeps crashing, even in safe mode; opening a rescue terminal (close it to log out)"
        "$BIN/samurai" doctor --quick 2>&1 | tail -n 4
        for t in alacritty xterm; do command -v "$t" >/dev/null 2>&1 && exec "$t" -e sh -c "echo 'Samurai keeps crashing. Log: $LOG'; echo 'Try: samurai doctor'; tail -n 30 '$LOG'; exec \$SHELL"; done
        exit "$rc"
    fi
    if [ "$n" -ge 3 ]; then
        echo "samurai-wm crashed $n times in a minute: starting it in safe mode"
        safe=1
        crashes=""
    fi
    sleep $((n > 3 ? 3 : n))
done
