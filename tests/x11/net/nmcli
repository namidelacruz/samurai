#!/bin/sh
# test stand-in (see tests/greeter_wifi.py and tests/wm_xvfb.py): fixed answers, every call logged
# stand-in nmcli for tests
echo "nmcli $*" >> "${NET_CALLS:-/dev/null}"
case "$*" in
  "-t -f WIFI radio") echo enabled;;
  "-t -f TYPE,STATE,CONNECTION device") printf 'wifi:connected:Home 5G\nethernet:unavailable:\n';;
  "-t -f IN-USE,SSID,SIGNAL,SECURITY device wifi list"*) printf '*:Home 5G:82:WPA2\n:UC-Secure:74:WPA2 802.1X\n:eduroam:70:WPA2 802.1X\n:Cafe Libre:58:\n:Neighbour\\:Net:41:WPA2\n::30:WPA2\n:Printer-DIRECT:22:WPA2\n';;
  "-t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list"*) printf '*:82:WPA2:Home 5G\n:74:WPA2 802.1X:UC-Secure\n:70:WPA2 802.1X:eduroam\n:58::Cafe Libre\n:41:WPA2:Neighbour\\:Net\n:30:WPA2:\n:22:WPA2:Printer-DIRECT\n';;
  "-t -f NAME,TYPE connection show") printf 'SN Home 5G:802-11-wireless\nCafe Libre:802-11-wireless\nWired:802-3-ethernet\n';;
  "device wifi connect"*) [ -n "$NM_FAIL" ] && { echo "Error: Connection activation failed: Secrets were required, but not provided." >&2; exit 4; }; echo ok;;
  *) echo ok;;
esac
