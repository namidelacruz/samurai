#!/bin/sh
# test stand-in (see tests/greeter_wifi.py and tests/wm_xvfb.py): fixed answers, every call logged
read pw; echo "shadow $* (password length ${#pw})" >> "${NET_CALLS:-/dev/null}"
[ "$pw" = right ] && exit 0; echo "Error: Connection activation failed: Secrets were required, but not provided." >&2; exit 1
