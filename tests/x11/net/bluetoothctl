#!/bin/sh
# test stand-in (see tests/greeter_wifi.py and tests/wm_xvfb.py): fixed answers, every call logged
echo "bluetoothctl $*" >> "${NET_CALLS:-/dev/null}"
case "$*" in
  show) echo "Powered: yes";;
  "devices Paired") printf 'Device AA:BB:CC:00:11:22 WH-1000XM4\nDevice 11:22:33:44:55:66 Keyboard K380\n';;
  "devices Connected") printf 'Device AA:BB:CC:00:11:22 WH-1000XM4\n';;
  *) echo ok;;
esac
