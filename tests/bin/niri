#!/bin/sh
# Test stand-in for the `niri` command. Not niri.
#   niri validate -c FILE     -> the real niri config parser when $NIRI_VALIDATOR points at one
#                                (a small program built from niri's own niri-config crate); otherwise accepted unchecked
#   niri msg -j workspaces|windows|outputs|focused-window   -> a fixed picture: one screen, a
#                                terminal on workspace 1, a browser parked on the shelf ("min")
#   niri msg action …         -> recorded in $NIRI_FAKE_LOG, exit 0
case "$1" in
validate)
    shift; [ "$1" = -c ] && shift
    [ -n "${NIRI_VALIDATOR:-}" ] && exec "$NIRI_VALIDATOR" "$1"
    exit 0;;
--version) echo "niri (test stand-in)"; exit 0;;
msg)
    shift; [ "$1" = -j ] || [ "$1" = --json ] && shift
    case "$1" in
    workspaces) echo '[{"id":1,"idx":1,"name":null,"output":"eDP-1","is_urgent":false,"is_active":true,"is_focused":true,"active_window_id":10},{"id":2,"idx":2,"name":"min","output":"eDP-1","is_urgent":false,"is_active":false,"is_focused":false,"active_window_id":11},{"id":3,"idx":3,"name":null,"output":"eDP-1","is_urgent":false,"is_active":false,"is_focused":false,"active_window_id":null}]';;
    windows) echo '[{"id":10,"title":"nami@katana: ~","app_id":"kitty","pid":1,"workspace_id":1,"is_focused":true,"is_floating":false,"is_urgent":false},{"id":11,"title":"Docs","app_id":"firefox","pid":2,"workspace_id":2,"is_focused":false,"is_floating":false,"is_urgent":false}]';;
    focused-window) echo '{"id":10,"title":"nami@katana: ~","app_id":"kitty","workspace_id":1,"is_focused":true}';;
    outputs) echo '{"eDP-1":{"name":"eDP-1","make":"Dell","model":"14 Plus","modes":[{"width":2560,"height":1600,"refresh_rate":120000,"is_preferred":true}],"current_mode":0,"logical":{"x":0,"y":0,"width":1707,"height":1067,"scale":1.5,"transform":"Normal"}}}';;
    action) shift; [ -z "${NIRI_FAKE_LOG:-}" ] || echo "$*" >> "$NIRI_FAKE_LOG";;
    event-stream) exit 0;;
    *) exit 1;;
    esac; exit 0;;
esac
exit 1
