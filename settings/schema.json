{
 "version": 2,
 "pages": [
  {
   "id": "look",
   "title": "Look",
   "icon": "ink",
   "lead": "Night or paper, one accent, your ink. Everything here changes at once.",
   "custom": "look",
   "sections": [
    {
     "title": "Ground",
     "items": [
      {
       "key": "look.ground",
       "label": "Ground",
       "type": "enum",
       "default": "sun",
       "options": [
        {
         "value": "night",
         "label": "Night"
        },
        {
         "value": "paper",
         "label": "Paper"
        },
        {
         "value": "sun",
         "label": "Follow the sun"
        }
       ],
       "help": "Follow the sun: paper during the day, night after dark (the times below)."
      },
      {
       "key": "look.sun_from",
       "label": "Paper from",
       "type": "text",
       "default": "07:30",
       "help": "When the paper ground starts, as HH:MM.",
       "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
      },
      {
       "key": "look.sun_to",
       "label": "Night from",
       "type": "text",
       "default": "18:00",
       "help": "When the night ground starts, as HH:MM.",
       "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$"
      },
      {
       "key": "look.accent",
       "label": "Accent",
       "type": "enum",
       "default": "indigo",
       "options": [
        {
         "value": "indigo",
         "label": "Indigo"
        },
        {
         "value": "moss",
         "label": "Moss"
        },
        {
         "value": "rust",
         "label": "Rust"
        },
        {
         "value": "plum",
         "label": "Plum"
        },
        {
         "value": "slate",
         "label": "Slate"
        }
       ],
       "help": "Used for focus, selection and the ink in the wallpaper."
