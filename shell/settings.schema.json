  {
   "id": "displays",
   "jp": "画面",
   "en": "DISPLAYS",
   "group": "system",
   "blurb": "Every monitor: mode, scale, place, rotation. Applies live; saved per set of monitors.",
   "sections": [
    {
     "jp": "全",
     "en": "ALL SCREENS",
     "items": [
      {
       "key": "displays.new_windows",
       "label": "New windows open on",
       "type": "enum",
       "default": "focused",
       "options": [
        "focused",
        "external",
        "primary"
       ],
       "use": "niri",
       "soon": true
      },
      {
       "key": "displays.vrr",
       "label": "Adaptive sync",
       "type": "toggle",
       "default": false,
       "use": "niri"
      },
      {
       "key": "displays.night.enabled",
       "label": "Night light",
       "type": "toggle",
       "default": false,
       "use": "shell"
      },
      {
       "key": "displays.night.from",
       "label": "Night light from",
       "type": "text",
       "default": "20:00",
       "use": "shell"
      },
      {
       "key": "displays.night.to",
       "label": "Night light until",
       "type": "text",
       "default": "07:00",
       "use": "shell"
      },
      {
       "key": "displays.night.kelvin",
       "label": "Night light warmth (K)",
       "type": "int",
       "default": 4000,
       "min": 2500,
       "max": 6500,
       "step": 100,
       "use": "shell"
      },
      {
       "key": "displays.monitors",
       "label": "Monitors",
       "type": "list",
       "default": [],
       "columns": [
        "output",
        "mode",
        "position",
        "scale",
        "transform",
        "disabled"
       ],
       "example": "eDP-1 · 2560x1600@120 · 0,0 · 1.5 · normal · no",
       "use": "niri"
      }
     ]
    }
   ],
   "custom": "displays"
  },
  {
