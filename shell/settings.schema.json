      {
       "key": "net.hotspot.password",
       "label": "Hotspot password (kept in the keyring, not here)",
       "type": "text",
       "default": "",
       "secret": true,
       "use": "services",
       "soon": true
      }
     ]
    }
   ],
   "custom": "connect"
  },
  {
   "id": "gpu",
   "jp": "描画",
   "en": "GPU",
   "group": "system",
   "blurb": "Which GPU draws the desktop, and passthrough to virtual machines.",
   "sections": [
    {
     "jp": "描画",
     "en": "RENDER",
     "items": [
      {
       "key": "gpu.mode",
       "label": "Render GPU",
       "type": "enum",
       "default": "auto",
       "options": [
        "auto",
        "integrated",
        "discrete"
       ],
       "use": "niri",
       "soon": true
      }
     ]
    },
    {
     "jp": "通過",
     "en": "PASSTHROUGH (VFIO)",
     "items": [
      {
       "key": "",
       "label": "Passthrough changes the bootloader and initramfs. Samurai only checks readiness and writes the files after you confirm; it never touches firmware settings.",
       "type": "note"
      },
      {
       "key": "gpu.passthrough.enabled",
       "label": "Reserve the discrete GPU for virtual machines",
       "type": "toggle",
       "default": false,
       "use": "services",
       "danger": true,
       "soon": true
      },
      {
       "key": "",
       "label": "Check readiness (IOMMU, groups, drivers)",
       "type": "action",
       "cmd": [
        "samurai",
        "gpu",
        "check"
       ]
      }
     ]
    }
   ],
   "custom": "gpu"
  },
  {
