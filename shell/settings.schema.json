  {
   "id": "keybinds",
   "jp": "鍵",
   "en": "KEYBINDS",
   "group": "system",
   "blurb": "Your own binds sit on top of the built-in ones. A bind that shadows a built-in one is flagged, never applied silently.",
   "sections": [
    {
     "jp": "鍵",
     "en": "OPTIONS",
     "items": [
      {
       "key": "binds.mod",
       "label": "Main modifier",
       "type": "enum",
       "default": "SUPER",
       "options": [
        "SUPER",
        "ALT",
        "CTRL"
       ],
       "use": "niri"
      },
      {
       "key": "binds.custom",
       "label": "Custom binds",
       "type": "list",
       "default": [],
       "columns": [
        "keys",
        "action",
        "arg",
        "name",
        "flags"
       ],
       "example": "SUPER + SHIFT + T · spawn · kitty · Scratch terminal · ",
       "use": "niri"
      },
      {
       "key": "binds.disabled",
       "label": "Built-in binds turned off",
       "type": "list",
       "default": [],
       "columns": [
        "id"
       ],
       "example": "win.close",
       "use": "niri"
      },
      {
       "key": "binds.moved",
       "label": "Built-in binds moved",
       "type": "list",
       "default": [],
       "columns": [
        "id",
        "keys"
       ],
       "example": "frame.widgets · SUPER + SHIFT + W",
       "use": "niri"
      },
      {
       "key": "binds.mouse",
       "label": "Extra mouse buttons",
       "type": "list",
       "default": [],
       "columns": [
        "button",
        "action",
        "arg"
       ],
       "example": "MouseBack · workspace · e-1",
       "use": "niri"
      }
     ]
    }
   ],
   "custom": "keybinds"
  },
  {
   "id": "connect",
   "jp": "接続",
